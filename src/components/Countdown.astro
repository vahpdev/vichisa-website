---
import { WEDDING } from "../config";

const DAY_MS = 86_400_000;

function countdown() {
  const days = Math.ceil((new Date(WEDDING).getTime() - Date.now()) / DAY_MS);
  if (days > 1) return { number: String(days), label: "días para el gran día" };
  if (days === 1) return { number: "1", label: "día para el gran día" };
  return { number: "¡Hoy!", label: "" };
}

const initial = countdown();
---

<p class="count" aria-live="polite" data-wedding={WEDDING}>
  <b data-days>{initial.number}</b>
  <span data-days-label>{initial.label}</span>
</p>

<script>
  const DAY_MS = 86_400_000;
  const el = document.querySelector("[data-wedding]");
  if (el instanceof HTMLElement) {
    const wedding = new Date(el.dataset.wedding ?? "").getTime();
    const number = el.querySelector("[data-days]");
    const label = el.querySelector("[data-days-label]");
    const update = () => {
      const days = Math.ceil((wedding - Date.now()) / DAY_MS);
      if (days > 1) {
        if (number) number.textContent = String(days);
        if (label) label.textContent = "días para el gran día";
      } else if (days === 1) {
        if (number) number.textContent = "1";
        if (label) label.textContent = "día para el gran día";
      } else {
        if (number) number.textContent = "¡Hoy!";
        if (label) label.textContent = "";
      }
    };
    update();
    window.setInterval(update, 60_000);
  }
</script>
