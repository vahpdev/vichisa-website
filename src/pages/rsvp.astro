---
import Pager from "../components/Pager.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout page="rsvp" title="Confirmar asistencia">
  <section class="page">
    <header class="head">
      <p class="eyebrow">Antes del 15 de mayo de 2027</p>
      <h2>
        Confirmar <em>asistencia</em>
      </h2>
    </header>
    <p class="lead">
      <em class="todo">En preparación</em> — el formulario de confirmación se publica aquí en una
      iteración posterior.
    </p>
    <Pager current="rsvp" />
  </section>
</BaseLayout>
