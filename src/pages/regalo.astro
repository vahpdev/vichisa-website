---
import Pager from "../components/Pager.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { IBAN } from "../config";
---

<BaseLayout page="regalo" title="Regalo">
  <section class="page">
    <div class="gift">
      <span class="motif" aria-hidden="true"></span>
      <h1>
        Su <em>regalo</em>
      </h1>
      <p class="msg">
        No les pedimos nada: que estén con nosotros ese día es el mejor regalo que podemos tener.
      </p>
      <p class="msg muted">
        Si aun así quieren ayudarnos a empezar nuestra vida juntos y a disfrutar de nuestra luna de
        miel, aquí les dejamos nuestro número de cuenta.
      </p>
      <div class="iban">
        <span class="eyebrow">IBAN</span>
        <code id="iban">{IBAN}</code>
        <span class="who">Titulares: Isabel y Vicente</span>
        <div class="row" style="justify-content: center">
          <button class="cta ghost" type="button" id="copy-iban">
            Copiar número de cuenta
          </button>
        </div>
        <p class="muted" id="iban-msg" hidden></p>
      </div>
      <p class="muted">Gracias de corazón.</p>
    </div>

    <Pager current="regalo" />
  </section>
</BaseLayout>

<script>
  const iban = document.getElementById("iban");
  const btn = document.getElementById("copy-iban");
  const msg = document.getElementById("iban-msg");

  function fallbackCopy() {
    const selection = window.getSelection();
    if (!selection || !iban) return;
    const range = document.createRange();
    range.selectNodeContents(iban);
    selection.removeAllRanges();
    selection.addRange(range);
    if (msg) {
      msg.hidden = false;
      msg.textContent =
        "No se pudo copiar automáticamente. El número está seleccionado: cópialo a mano.";
    }
  }

  async function copyIban() {
    const text = iban?.textContent ?? "";
    if (!text) return;
    try {
      if (!navigator.clipboard) throw new Error("Clipboard API not available");
      await navigator.clipboard.writeText(text);
      if (msg) {
        msg.hidden = false;
        msg.textContent = "Número de cuenta copiado.";
      }
    } catch {
      fallbackCopy();
    }
  }

  btn?.addEventListener("click", copyIban);
</script>
